    "      end: Alignment(x + 2, 0),",
    "      colors: [_grey, _light, _grey],",
    "      stops: const [0.35, 0.5, 0.65],",
    "    ).createShader(rect);",
    "  },",
    "  child: const Bones(),",
    ");"

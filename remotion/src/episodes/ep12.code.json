{
  "code1": [
    "@override",
    "void paint(Canvas canvas, Size s) {",
    "  final c = s.center(Offset.zero);",
    "  final rect = Rect.fromCircle(",
    "      center: c, radius: radius);",
    "  final pen = Paint()",
    "    ..color = color",
    "    ..style = PaintingStyle.stroke",
    "    ..strokeWidth = 28",
    "    ..strokeCap = StrokeCap.round;",
    "  canvas.drawArc(rect, -pi / 2,",
    "      2 * pi * progress, false, pen);",
    "}"
  ],
  "trap": [
    "// Move goal hit: 130%",
    "canvas.drawArc(rect, -pi / 2,",
    "    2 * pi * 1.3, false, pen);",
    "// sweep > 2*pi = just a full circle"
  ],
  "code2": [
    "final laps = progress.floor();",
    "final rest = progress - laps;",
    "if (laps > 0) {",
    "  canvas.drawCircle(c, radius, pen);",
    "}",
    "final end = 2 * pi * rest;",
    "final tip = end - pi / 2;",
    "if (laps > 0) {",
    "  // blurred shadow under lap 2 tip",
    "  canvas.drawArc(rect, tip - 0.1, 0.35,",
    "      false, _tipShadow);",
    "}",
    "canvas.drawArc(rect, -pi / 2, end,",
    "    false, pen);"
  ]
}
